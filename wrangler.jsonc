{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apps-ninochavez-router",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "apps.ninochavez.co/*", "zone_name": "ninochavez.co" }
  ]
}
